# =============================================================================
# Creator Content Radar — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys.
#   cp .env.example .env

# REQUIRED — YouTube Data API v3 (free quota: 10,000 units/day)
YOUTUBE_API_KEY=""

# REQUIRED — Google Gemini (free tier available)
GEMINI_API_KEY=""

# REQUIRED — JWT Secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY="change-me-to-a-random-secret"

# OPTIONAL — Alternative AI Providers (fallback if Gemini fails)
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
AI_PROVIDER="auto"

# OPTIONAL — Reddit API (via PRAW, free)
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="creator-content-radar/0.1"

# OPTIONAL — Twitter/X API v2 (free tier: 500 posts/month)
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_BEARER_TOKEN=""

# OPTIONAL — Twitch API (free, Helix API)
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# OPTIONAL — TikTok API (via Apify/BrightData)
TIKTOK_API_KEY=""

# OPTIONAL — Instagram API (via Apify/BrightData)
INSTAGRAM_API_KEY=""

# OPTIONAL — Stripe Payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_BUSINESS_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_BUSINESS_ANNUAL=""

# DATABASE — PostgreSQL for production, SQLite for local dev
# Default: PostgreSQL
DATABASE_URL="postgresql://user:password@host:5432/creator_radar?sslmode=require"
# SQLite (local dev):
# DATABASE_URL="sqlite:///./data/cache.db"

# OPTIONAL — App URL (used for Stripe redirects)
APP_URL="http://localhost:8000"

# OPTIONAL — Sentry error tracking
SENTRY_DSN=""

# OPTIONAL — PostHog product analytics
POSTHOG_API_KEY=""

# OPTIONAL — SendGrid email service
SENDGRID_API_KEY=""

# OPTIONAL — Scheduler (enables daily snapshots + weekly reports)
SCHEDULER_ENABLED=false

# OPTIONAL — Debug mode (enables /docs, /redoc, tracebacks)
DEBUG=false
