# =============================================================================
# Creator Content Radar — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys.
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — YouTube Data API v3 (free quota: 10,000 units/day)
# Get one: https://console.cloud.google.com/apis/library/youtube.googleapis.com
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=""

# ---------------------------------------------------------------------------
# REQUIRED — Google Gemini (free tier available)
# Get one: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=""

# ---------------------------------------------------------------------------
# REQUIRED — JWT Secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# ---------------------------------------------------------------------------
SECRET_KEY="change-me-to-a-random-secret"

# ---------------------------------------------------------------------------
# OPTIONAL — Alternative AI Providers (fallback if Gemini fails)
# ---------------------------------------------------------------------------
# Groq (free): https://console.groq.com/keys
GROQ_API_KEY=""

# OpenRouter (paid, many models): https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Provider selection: "auto" (default), "gemini", "groq", "openrouter"
AI_PROVIDER="auto"

# ---------------------------------------------------------------------------
# OPTIONAL — Reddit API (via PRAW, free)
# Create an app: https://www.reddit.com/prefs/apps
# ---------------------------------------------------------------------------
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="creator-content-radar/0.1"

# ---------------------------------------------------------------------------
# OPTIONAL — Twitter/X API v2 (free tier: 500 posts/month, 1 project)
# Get one: https://developer.twitter.com/en/portal/dashboard
# ---------------------------------------------------------------------------
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_BEARER_TOKEN=""

# ---------------------------------------------------------------------------
# OPTIONAL — Twitch API (free, Helix API)
# Register an app: https://dev.twitch.tv/console/apps
# ---------------------------------------------------------------------------
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# OPTIONAL — Stripe Payments (for SaaS billing)
# Get keys: https://dashboard.stripe.com/apikeys
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_BUSINESS_MONTHLY=""

# ---------------------------------------------------------------------------
# OPTIONAL — Database (SQLite by default, switch to PostgreSQL for production)
# ---------------------------------------------------------------------------
# SQLite (local dev):
DATABASE_URL="sqlite:///./data/cache.db"
# PostgreSQL (production):
# DATABASE_URL="postgresql://user:password@host:5432/creator_radar?sslmode=require"

# ---------------------------------------------------------------------------
# OPTIONAL — App URL (used for Stripe redirects, default works for local dev)
# ---------------------------------------------------------------------------
APP_URL="http://localhost:8000"
