# ── YouTube Data API v3 (public data: search, channel stats, video info) ──
YOUTUBE_API_KEY=

# ── YouTube Analytics API v2 (private channel metrics via OAuth) ──
# Uses the same Google OAuth credentials as the Google Sign-In flow.
# No separate key needed — the Analytics API is accessed via the OAuth access token
# obtained when the user connects their YouTube account.
# Required scopes (already configured in config.py):
#   https://www.googleapis.com/auth/yt-analytics.readonly
#   https://www.googleapis.com/auth/youtube.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI Provider (auto picks best available) ──
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
AI_PROVIDER=auto

# ── Reddit API ──
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=creator-content-radar/0.1

# ── Twitter/X API ──
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=

# ── Twitch API ──
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── TikTok API ──
TIKTOK_API_KEY=

# ── Instagram API ──
INSTAGRAM_API_KEY=

# ── Stripe (billing) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=

# ── App config ──
SECRET_KEY=
APP_URL=https://your-app.onrender.com
DATABASE_URL=sqlite:///./data/cache.db
ENVIRONMENT=production
