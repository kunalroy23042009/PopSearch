{
  "manifest_version": 3,
  "name": "Creator Content Radar",
  "version": "1.0.0",
  "description": "Analyze any YouTube channel directly from YouTube — view channel insights, competitors, and content ideas.",
  "permissions": ["storage"],
  "host_permissions": ["https://*.youtube.com/*", "https://creator-content-radar.onrender.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
